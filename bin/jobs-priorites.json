  {"name": "Scalo", "match": "scalo", "tier": 2},
  {"name": "Michelin", "match": "michelin", "tier": 3, "keep": "^(?!.*\\b(stage|stagiaire|alternan|apprenti)).*$|test|c\\+\\+|automatisation|microsoft 365|m365|logiciel|software|d[ée]velopp|data|devops", "exclude": "consultant|innovation digital|marketing|commercial|rh\\b"},
  {"name": "OVHcloud", "match": "ovh", "tier": 4, "devOnly": true, "exclude": "cert|expert|sales|commercial|account|juriste|legal|finance|achat|recrut"},
  {"name": "CND", "match": "commissariat au num[ée]rique|\\bcnd\\b", "tier": 5, "keep": "d[ée]veloppeur|developer|lead dev|tech lead|ing[ée]nieur logiciel", "exclude": "chef de projet|charg[ée]|technicien|administrati|assistant|gestionnaire|expert si"}
 ],
 "others": {"tier": 6, "devOnly": true, "exclude": "head of product|product manager|sales|commercial|marketing|recrut|rh\\b|comptab"}
}
